---
import { db } from "../lib/db";
import type { TicketRow } from "../lib/db";
import { TICKET_CATEGORIES } from "../lib/tickets";
import type { TicketCategory } from "../lib/tickets";

interface Props {
  userId: number;
  /** open ones go on the Tickets tab, closed ones on Old Tickets */
  status: "open" | "closed";
}
const { userId, status } = Astro.props;
const tickets = db
  .prepare("SELECT * FROM tickets WHERE user_id = ? AND status = ? ORDER BY updated_at DESC LIMIT 100")
  .all(userId, status) as TicketRow[];
---

{
  tickets.length === 0 ? (
    <p class="admin-empty">{status === "open" ? "No open tickets." : "No closed tickets yet."}</p>
  ) : (
    <ul class="ticket-list">
      {tickets.map((t) => (
        <li class="ticket-list-item">
          <a href={`/support/${t.id}`} class="ticket-list-row">
            <span class="ticket-list-main">
              <strong>{t.subject}</strong>
              <small>
                #{t.id} · {TICKET_CATEGORIES[t.category as TicketCategory] ?? t.category} ·{" "}
                <time datetime={`${t.updated_at}Z`} data-local>{t.updated_at}</time>
              </small>
            </span>
            {t.status === "closed" ? (
              <span class="ticket-state is-closed">Closed</span>
            ) : t.awaiting === "customer" ? (
              <span class="ticket-state is-you">Reply waiting</span>
            ) : (
              <span class="ticket-state">Waiting on staff</span>
            )}
          </a>
          {status === "closed" && (
            // a sibling of the row link, not inside it: a link can't hold another link
            <a
              class="btn btn-ghost btn-sm"
              href={`/api/tickets/${t.id}/transcript`}
              download
              aria-label={`Download transcript for ticket #${t.id}`}
            >
              Download transcript
            </a>
          )}
        </li>
      ))}
    </ul>
  )
}
