---
import Layout from "../layouts/Layout.astro";

const lastUpdated = "August 13, 2026";

const intro =
  "Welcome to Kez Modifications. By purchasing, downloading, or using any of our products or services, you agree to be bound by the following Terms of Service. Please read them carefully before proceeding.";

const sections: { title: string; body: string[] }[] = [
  {
    title: "General",
    body: [
      "All sales are final. Refunds or exchanges will not be issued unless explicitly stated in writing by Kez Modifications.",
      "By completing a purchase, you confirm that you are authorized to use the payment method provided.",
      "Kez Modifications reserves the right to deny service or access to any individual who violates these terms.",
    ],
  },
  {
    title: "Terms of Usage",
    body: [
      "Redistribution, resale, leaking, or sharing of any Kez Modifications products, whether free or paid, is strictly prohibited.",
      "You may only use our assets for personal or server use and may not claim them as your own work.",
      "Any use of our assets for illegal or malicious activity is not permitted under any circumstance.",
    ],
  },
  {
    title: "Intellectual Property",
    body: [
      "All assets, scripts, designs, and materials remain the exclusive intellectual property of Kez Modifications.",
      "Unauthorized modification, repackaging, or rebranding of our work without written consent is strictly prohibited.",
      "You are not permitted to remove or alter any Kez Modifications branding, credits, or markings without approval.",
    ],
  },
  {
    title: "Liability",
    body: [
      "Kez Modifications is not responsible for any damages, performance issues, or data loss that may occur from using our products.",
      "It is the client's responsibility to verify compatibility with their server or framework before making a purchase.",
      "All assets are provided as is, without any guarantee of functionality in modified or third-party environments.",
    ],
  },
  {
    title: "Payment and Delivery",
    body: [
      "All payments must be made in full prior to the delivery of any product or service.",
      "Products are delivered within the timeframe stated at the time of purchase.",
      "Chargebacks, disputes, or unauthorized payment claims will result in an immediate ban.",
    ],
  },
  {
    title: "Breach of Terms",
    body: [
      "Violation of these terms may result in service termination, removal of access, or a blacklist from Kez Modifications.",
    ],
  },
  {
    title: "Changes to Terms",
    body: [
      "Kez Modifications reserves the right to update or revise these Terms of Service at any time without prior notice.",
      "Any changes will be communicated through an announcement or other appropriate channels.",
    ],
  },
];

const closing =
  "By purchasing or using any of our services, you acknowledge that you have read, understood, and agreed to these Terms of Service. Thank you for choosing Kez Modifications!";
---

<Layout title="Terms of Service - Kez Modifications" description="Terms of Service for Kez Modifications digital products.">
  <div class="legal-page">
    <header class="legal-header">
      <div class="about-label">Legal</div>
      <h1>Terms of Service</h1>
      <p class="legal-updated">Last updated {lastUpdated}</p>
    </header>

    <p>{intro}</p>

    {
      sections.map((s) => (
        <section class="legal-section">
          <h2>{s.title}</h2>
          {s.body.map((p) => (
            <p>{p}</p>
          ))}
        </section>
      ))
    }

    <p>{closing}</p>
  </div>
</Layout>
