---
import Layout from "../layouts/Layout.astro";
import { db } from "../lib/db";
import type { PackRow } from "../lib/db";
import { isDownloadable, ownsPack } from "../lib/ownership";
import { CART_COOKIE } from "../lib/cart";
import TicketList from "../components/TicketList.astro";

const user = Astro.locals.user;

let ownedPacks: PackRow[] = [];
let preorders: PackRow[] = [];
let justReleased: string[] = [];
if (user) {
  const allPacks = db.prepare("SELECT * FROM packs ORDER BY sort_order, id").all() as PackRow[];
  ownedPacks = allPacks.filter((p) => ownsPack(user.id, p));
  preorders = db
    .prepare(
      `SELECT DISTINCT p.* FROM orders o JOIN packs p ON p.id = o.pack_id
       WHERE o.user_id = ? AND o.status = 'preorder' ORDER BY p.sort_order, p.id`,
    )
    .all(user.id) as PackRow[];
  // two weeks felt right, long enough that people who check in weekly still see it
  justReleased = (
    db
      .prepare(
        `SELECT DISTINCT p.name FROM orders o JOIN packs p ON p.id = o.pack_id
         WHERE o.user_id = ? AND o.released_at > datetime('now', '-14 days')`,
      )
      .all(user.id) as { name: string }[]
  ).map((r) => r.name);
}

const TABS = [
  ["overview", "Overview"],
  ["downloads", "Downloads"],
  ["tickets", "Tickets"],
  ["old-tickets", "Old Tickets"],
] as const;
type Tab = (typeof TABS)[number][0];
const asked = Astro.url.searchParams.get("tab") ?? "";
const tab: Tab = TABS.some(([k]) => k === asked) ? (asked as Tab) : "overview";

const count = (status: string) =>
  user
    ? (db.prepare("SELECT COUNT(*) AS n FROM tickets WHERE user_id = ? AND status = ?").get(user.id, status) as { n: number }).n
    : 0;
const openTickets = count("open");
const closedTickets = count("closed");
const replyWaiting = user
  ? (db.prepare("SELECT COUNT(*) AS n FROM tickets WHERE user_id = ? AND status = 'open' AND awaiting = 'customer'").get(user.id) as { n: number }).n
  : 0;
const memberSince = user
  ? (db.prepare("SELECT created_at FROM users WHERE id = ?").get(user.id) as { created_at: string } | undefined)?.created_at
  : undefined;
const tabCount: Partial<Record<Tab, number>> = { downloads: ownedPacks.length, tickets: openTickets, "old-tickets": closedTickets };

const q = Astro.url.searchParams;
// landing here after checkout means the cart went through; drop it so the
// same packs don't sit in the nav badge as "owned" leftovers
if (q.get("purchase") === "success" || q.get("claimed") === "1") {
  Astro.cookies.delete(CART_COOKIE, { path: "/" });
}
const notice = q.get("purchase") === "success"
  ? preorders.length
    ? "Payment complete. Anything live is delivered; pre-orders arrive the day they release."
    : "Payment complete — your Discord role has been delivered."
  : q.get("claimed") === "1"
    ? preorders.length
      ? "Claimed. Anything live is delivered; pre-orders arrive the day they release."
      : "Pack claimed — your Discord role has been delivered."
    : null;
---

<Layout title="Account - Kez Modifications" active="account" noindex>
  {
    !user ? (
      <div class="login-cta">
        <h1>Your account</h1>
        <p>Sign in with Discord to see your packs and downloads.</p>
        <a href="/api/auth/login?next=/account" class="btn btn-primary">
          Sign in with Discord
        </a>
      </div>
    ) : (
      <div class="account-page">
        <div class="account-header">
          {user.image && <img src={user.image} alt="" class="account-avatar" />}
          <div>
            <h1>{user.name}</h1>
            <p>Discord ID: {user.discordId}</p>
          </div>
          <form method="post" action="/api/auth/logout" style="margin-left:auto;">
            <button class="btn btn-ghost btn-sm" type="submit">
              Sign out
            </button>
          </form>
        </div>

        {/* plain links, not an ARIA tab widget: every tab is a real URL, so back/forward,
            bookmarks and keyboard all work with zero script */}
        <div class="account-tabs" role="navigation" aria-label="Account sections">
          {
            TABS.map(([key, label]) => (
              <a href={key === "overview" ? "/account" : `/account?tab=${key}`} aria-current={key === tab ? "page" : undefined}>
                {label}
                {tabCount[key] ? <span class="account-tab-count">{tabCount[key]}</span> : null}
              </a>
            ))
          }
        </div>

        {tab === "overview" && (
          <>
            {notice && <div class="success-note">{notice}</div>}
            {justReleased.length > 0 && (
              <div class="success-note">
                Released: {justReleased.join(", ")}. Your pre-order is delivered, download it from the{" "}
                <a href="/account?tab=downloads" style="text-decoration:underline;">Downloads tab</a>.
              </div>
            )}

            <div class="account-summary">
              <a href="/account?tab=downloads" class="account-stat">
                <strong>{ownedPacks.length}</strong>
                <span>Pack{ownedPacks.length === 1 ? "" : "s"} owned</span>
              </a>
              <a href="/account?tab=tickets" class="account-stat">
                <strong>{openTickets}</strong>
                <span>
                  Open ticket{openTickets === 1 ? "" : "s"}{replyWaiting > 0 ? `, ${replyWaiting} waiting on you` : ""}
                </span>
              </a>
              <div class="account-stat">
                <strong>{memberSince ? new Date(`${memberSince.replace(" ", "T")}Z`).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" }) : "Today"}</strong>
                <span>Member since</span>
              </div>
            </div>

            {preorders.length > 0 && (
              <div class="account-section">
                <h2>Pre-orders</h2>
                {preorders.map((pack) => (
                  <div class="owned-row">
                    {pack.image_url ? <img class="owned-thumb" src={pack.image_url} alt="" /> : <div class="owned-thumb" />}
                    <div class="owned-name">{pack.name}</div>
                    <span class="badge badge-preorder">Awaiting release</span>
                  </div>
                ))}
              </div>
            )}
          </>
        )}

        {tab === "downloads" && (
          <div class="account-section">
            <h2>Your packs</h2>
            {ownedPacks.length === 0 ? (
              <p class="admin-empty">
                You don't own anything yet. <a href="/shop" style="color:var(--accent);">Browse the shop</a>.
              </p>
            ) : (
              ownedPacks.map((pack) => (
                <div class="owned-row">
                  {pack.image_url ? <img class="owned-thumb" src={pack.image_url} alt="" /> : <div class="owned-thumb" />}
                  <div class="owned-name">{pack.name}</div>
                  <a href={`/product/${pack.id}`} class="btn btn-ghost btn-sm">
                    View
                  </a>
                  {isDownloadable(pack) && (
                    <a href={`/api/download/${pack.id}`} class="btn btn-primary btn-sm">
                      Download
                    </a>
                  )}
                </div>
              ))
            )}
          </div>
        )}

        {tab === "tickets" && (
          <div class="account-section">
            <div class="account-section-head">
              <h2>Open tickets</h2>
              <a href="/support#new-ticket" class="btn btn-ghost btn-sm">
                New ticket
              </a>
            </div>
            <TicketList userId={user.id} status="open" />
          </div>
        )}

        {tab === "old-tickets" && (
          <div class="account-section">
            <div class="account-section-head">
              <h2>Old tickets</h2>
            </div>
            <TicketList userId={user.id} status="closed" />
          </div>
        )}
      </div>
    )
  }
</Layout>

<script>
  document.querySelectorAll<HTMLTimeElement>("time[data-local]").forEach((t) => {
    t.textContent = new Date(t.dateTime.replace(" ", "T")).toLocaleString([], { dateStyle: "medium", timeStyle: "short" });
  });
</script>
