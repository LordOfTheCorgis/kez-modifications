---
import Layout from "../layouts/Layout.astro";
import { db } from "../lib/db";
import type { PackRow } from "../lib/db";
import { readCart } from "../lib/cart";
import { ownsPack } from "../lib/ownership";

const user = Astro.locals.user;
const ids = readCart(Astro.cookies);

// keep the cookie's order so the list doesn't reshuffle every time you remove one
const packs = ids
  .map((id) => db.prepare("SELECT * FROM packs WHERE id = ?").get(id) as PackRow | undefined)
  .filter((p): p is PackRow => !!p);
const items = packs.map((pack) => ({
  pack,
  owned: user ? ownsPack(user.id, pack) : false,
  // hidden or flipped back to coming soon after it went in the cart
  unavailable: pack.status === "hidden" || pack.status === "coming_soon",
}));
const buyable = items.filter((i) => !i.owned && !i.unavailable);
const subtotal = buyable.reduce((sum, i) => sum + i.pack.price, 0);
const fmt = (cents: number) => (cents === 0 ? "Free" : `$${(cents / 100).toFixed(2)}`);
const canceled = Astro.url.searchParams.get("canceled") === "1";
---

<Layout title="Cart - Kez Modifications" active="cart">
  <div class="cart-page">
    <h1>Your cart</h1>

    {canceled && <div class="error-note">Checkout canceled — you have not been charged.</div>}

    {
      items.length === 0 ? (
        <p class="admin-empty">
          Nothing in here yet — <a href="/shop" style="color:var(--accent);">browse the shop</a>.
        </p>
      ) : (
        <div class="cart-layout">
          <div id="cart-list">
            {items.map(({ pack, owned, unavailable }) => (
              <div class={`cart-row ${owned || unavailable ? "is-owned" : ""}`} data-pack-id={pack.id}>
                {pack.image_url ? <img class="cart-thumb" src={pack.image_url} alt="" /> : <div class="cart-thumb" />}
                <div class="cart-name">
                  <a href={`/product/${pack.id}`}>{pack.name}</a>
                  {owned && <small>You already own this — it won't be charged.</small>}
                  {!owned && unavailable && <small>Not available right now, so it's left out of checkout.</small>}
                  {!owned && !unavailable && pack.status === "preorder" && (
                    <small>Pre-order: charged now, delivered the day it releases.</small>
                  )}
                </div>
                <div class="cart-price">{owned ? "Owned" : unavailable ? "Unavailable" : fmt(pack.price)}</div>
                <button class="cart-remove" data-remove={pack.id} aria-label={`Remove ${pack.name} from cart`}>
                  ×
                </button>
              </div>
            ))}
          </div>

          <aside class="cart-summary" aria-labelledby="summary-heading">
            <h2 id="summary-heading">Summary</h2>
            <div class="cart-line">
              <span>
                Subtotal ({buyable.length} item{buyable.length === 1 ? "" : "s"})
              </span>
              <span>{fmt(subtotal)}</span>
            </div>
            <div class="cart-line cart-line-discount" id="cart-discount-line" hidden>
              <span id="cart-discount-label">Discount</span>
              <span id="cart-discount-amount" />
            </div>
            <div class="cart-total">
              <span>Total</span>
              <strong id="cart-total" data-subtotal={subtotal}>{fmt(subtotal)}</strong>
            </div>
            {buyable.length > 0 && subtotal > 0 && (
              <form class="cart-discount" id="discount-form">
                <label class="sr-only" for="discount-input">Discount code</label>
                <input class="form-input" id="discount-input" placeholder="Discount code" autocomplete="off" />
                <button class="btn btn-ghost" type="submit" id="discount-apply">Apply</button>
              </form>
            )}
            <div class="cart-discount-msg" id="discount-msg" role="status" />
            {buyable.length > 0 && user && (
              <label class="cart-tos">
                <input type="checkbox" id="tos-check" />
                <span>
                  I agree to the <a href="/terms" target="_blank" rel="noopener">Terms of Service</a>
                </span>
              </label>
            )}
            <div class="error-note" id="cart-error" />
            {
              buyable.length === 0 ? (
                <p class="admin-empty" style="padding:0;">Nothing here can be checked out right now.</p>
              ) : user ? (
                <button
                  class="btn btn-primary btn-purchase"
                  id="checkout-btn"
                  disabled
                  data-ids={buyable.map((i) => i.pack.id).join(",")}
                >
                  {subtotal === 0 ? "Claim for free" : "Checkout"}
                </button>
              ) : (
                <a class="btn btn-primary btn-purchase" href="/api/auth/login?next=/cart">
                  Sign in with Discord to checkout
                </a>
              )
            }
          </aside>
        </div>
      )
    }
  </div>
</Layout>

<script>
  import { cart } from "../lib/cart-client";

  document.querySelectorAll<HTMLButtonElement>("[data-remove]").forEach((btn) => {
    btn.addEventListener("click", () => {
      cart.remove(Number(btn.dataset.remove));
      // reload rather than re-render: the subtotal, the button label and the
      // discount field all depend on server-side ownership checks anyway
      location.reload();
    });
  });

  const fmt = (cents: number) => (cents === 0 ? "Free" : `$${(cents / 100).toFixed(2)}`);
  const checkoutBtn = document.getElementById("checkout-btn") as HTMLButtonElement | null;
  const tos = document.getElementById("tos-check") as HTMLInputElement | null;
  const codeInput = document.getElementById("discount-input") as HTMLInputElement | null;
  const msg = document.getElementById("discount-msg")!;
  const packIds = (checkoutBtn?.dataset.ids ?? "").split(",").filter(Boolean).map(Number);
  let applied = "";

  tos?.addEventListener("change", () => {
    if (checkoutBtn) checkoutBtn.disabled = !tos.checked;
  });

  document.getElementById("discount-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = document.getElementById("discount-apply") as HTMLButtonElement;
    const totalEl = document.getElementById("cart-total")!;
    const line = document.getElementById("cart-discount-line")!;
    const code = codeInput!.value.trim();
    msg.className = "cart-discount-msg";
    // empty submit = take the code off
    if (!code) {
      applied = "";
      line.hidden = true;
      totalEl.textContent = fmt(Number(totalEl.dataset.subtotal));
      msg.textContent = "";
      return;
    }
    btn.disabled = true;
    try {
      const res = await fetch("/api/discount", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ code, packIds }),
      });
      const data = await res.json().catch(() => null);
      if (res.ok && data) {
        applied = data.code;
        document.getElementById("cart-discount-label")!.textContent = `Discount (${data.code}, ${data.percent}% off)`;
        document.getElementById("cart-discount-amount")!.textContent = `−${fmt(data.savings)}`;
        line.hidden = false;
        totalEl.textContent = fmt(data.total);
        msg.textContent = "Code applied.";
        msg.classList.add("is-ok");
      } else {
        applied = "";
        line.hidden = true;
        totalEl.textContent = fmt(Number(totalEl.dataset.subtotal));
        msg.textContent = data?.error ?? "Couldn't check that code";
        msg.classList.add("is-bad");
      }
    } catch {
      msg.textContent = "Network error — try again";
      msg.classList.add("is-bad");
    }
    btn.disabled = false;
  });

  checkoutBtn?.addEventListener("click", async () => {
    const errBox = document.getElementById("cart-error")!;
    errBox.textContent = "";
    // typed a code but never hit apply: still send it, purchase.ts validates it either way
    const typed = codeInput?.value.trim() ?? "";
    checkoutBtn.disabled = true;
    const label = checkoutBtn.textContent;
    checkoutBtn.textContent = "Working…";
    try {
      const res = await fetch("/api/purchase", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          packIds,
          discountCode: typed || applied || undefined,
          tosAccepted: tos?.checked === true,
        }),
      });
      const data = await res.json().catch(() => null);
      if (data?.url) {
        // cart clears on the success page, not here, so a canceled checkout keeps it
        location.href = data.url;
        return;
      }
      if (data?.claimed) {
        cart.clear();
        location.href = "/account?claimed=1";
        return;
      }
      errBox.textContent = data?.error ?? `Something went wrong (HTTP ${res.status})`;
    } catch {
      errBox.textContent = "Network error — try again";
    }
    checkoutBtn.disabled = !tos?.checked;
    checkoutBtn.textContent = label;
  });
</script>
