---
import AdminLayout from "../../layouts/AdminLayout.astro";

if (!Astro.locals.user) return Astro.redirect("/api/auth/login?next=/admin/orders");
if (!Astro.locals.user.isAdmin) return Astro.redirect("/");
---

<AdminLayout section="orders" title="Orders">
  <div class="admin-section-header"><h1>Orders & sales log</h1></div>

  <div class="admin-card">
    <form class="admin-form" id="g-form">
      <div class="admin-form-2col">
        <div class="form-row">
          <label for="g-discord">Discord ID <span class="label-hint">they must have signed in once</span></label>
          <input class="form-input" id="g-discord" required pattern="[0-9]{15,22}" placeholder="123456789012345678" />
        </div>
        <div class="form-row">
          <label for="g-pack">Pack</label>
          <select class="form-input" id="g-pack" required></select>
        </div>
      </div>
      <div class="error-note" id="g-error"></div>
      <div class="admin-form-actions">
        <button class="btn btn-primary" type="submit">Grant pack</button>
      </div>
    </form>
  </div>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr><th>#</th><th>Buyer</th><th>Pack</th><th>Amount</th><th>Status</th><th>Delivery</th><th>Date</th></tr>
      </thead>
      <tbody id="o-rows"><tr><td colspan="7" class="admin-empty">Loading…</td></tr></tbody>
    </table>
  </div>
</AdminLayout>

<script>
  type Order = {
    id: number; user_name: string; discord_id: string; pack_name: string | null;
    amount: number | null; status: string; delivery_note: string | null; created_at: string;
  };

  async function load() {
    const res = await fetch("/api/admin/orders");
    const data = await res.json();
    const orders = document.getElementById("o-rows")!;
    orders.textContent = "";
    if (!data.orders?.length) {
      orders.innerHTML = '<tr><td colspan="7" class="admin-empty">No orders yet.</td></tr>';
    }
    for (const o of (data.orders ?? []) as Order[]) {
      const tr = document.createElement("tr");
      const add = (text: string) => {
        const td = document.createElement("td");
        td.textContent = text;
        tr.appendChild(td);
        return td;
      };
      add(String(o.id));
      add(`${o.user_name} (${o.discord_id})`);
      add(o.pack_name ?? "—");
      add(o.amount === null ? "—" : o.amount === 0 ? "Free" : `$${(o.amount / 100).toFixed(2)}`);
      const st = add("");
      const pill = document.createElement("span");
      pill.className = `status-pill ${o.status === "paid" ? "status-approved" : "status-pending"}`;
      pill.textContent = o.status;
      st.appendChild(pill);
      add(o.delivery_note ?? "—");
      add(new Date(o.created_at + "Z").toLocaleString());
      orders.appendChild(tr);
    }
  }
  load();

  // Manual grant: for people who bought before the store existed, or got a pack
  // some other way. Their Discord role doesn't unlock anything anymore.
  const gForm = document.getElementById("g-form") as HTMLFormElement;
  const gPack = document.getElementById("g-pack") as HTMLSelectElement;
  const gErr = document.getElementById("g-error")!;
  fetch("/api/admin/packs")
    .then((r) => r.json())
    .then((d) => {
      for (const p of (d.packs ?? []) as { id: number; name: string }[]) {
        const opt = document.createElement("option");
        opt.value = String(p.id);
        opt.textContent = p.name;
        gPack.appendChild(opt);
      }
    });
  gForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    gErr.textContent = "";
    const res = await fetch("/api/admin/orders", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        discord_id: (document.getElementById("g-discord") as HTMLInputElement).value.trim(),
        pack_id: Number(gPack.value),
      }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      gErr.textContent = data.error ?? `HTTP ${res.status}`;
      return;
    }
    gForm.reset();
    load();
  });
</script>
