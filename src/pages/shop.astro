---
import Layout from "../layouts/Layout.astro";
import PackCard from "../components/PackCard.astro";
import { db } from "../lib/db";
import type { CategoryRow, PackRow } from "../lib/db";
import { ownsPack } from "../lib/ownership";

const categories = db
  .prepare("SELECT * FROM categories ORDER BY sort_order, id")
  .all() as CategoryRow[];

const rawCategory = Astro.url.searchParams.get("category");
const activeCategory = rawCategory ? Number(rawCategory) : null;

const packs = (
  activeCategory
    ? db
        .prepare("SELECT * FROM packs WHERE category_id = ? AND status != 'hidden' ORDER BY sort_order, id")
        .all(activeCategory)
    : db.prepare("SELECT * FROM packs WHERE status != 'hidden' ORDER BY sort_order, id").all()
) as PackRow[];

const counts = new Map<number, number>();
for (const row of db
  .prepare("SELECT category_id, COUNT(*) AS n FROM packs WHERE status != 'hidden' GROUP BY category_id")
  .all() as { category_id: number | null; n: number }[]) {
  if (row.category_id !== null) counts.set(row.category_id, row.n);
}
const total = (db.prepare("SELECT COUNT(*) AS n FROM packs WHERE status != 'hidden'").get() as { n: number }).n;
const user = Astro.locals.user;

// a real category gets its own title, description and canonical. an unknown id
// renders the full shop, so it canonicalizes to /shop instead of becoming a duplicate page
const category = activeCategory ? categories.find((c) => c.id === activeCategory) : undefined;
const seoTitle = category
  ? `${category.name} for FiveM - Kez Modifications Shop`
  : "FiveM EUP Packs, Patches and Models - Kez Modifications Shop";
const seoDescription = category
  ? `Browse ${packs.length} ${category.name} pack${packs.length === 1 ? "" : "s"} for FiveM from Kez Modifications. Pay securely with Stripe and get your Discord role delivered automatically.`
  : "Shop server-ready FiveM EUP packs, patches and models from Kez Modifications. Pay securely with Stripe and get your Discord role delivered automatically.";
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={category ? `/shop?category=${category.id}` : "/shop"}
  active="shop"
>
  <div class="shop-layout">
    <aside class="sidebar">
      <div class="sidebar-label">Categories</div>
      <a href="/shop" class={`sidebar-item ${activeCategory === null ? "active" : ""}`}>
        <span>All packs</span>
        <span class="sidebar-count">{total}</span>
      </a>
      {
        categories.map((cat) => (
          <a
            href={`/shop?category=${cat.id}`}
            class={`sidebar-item ${activeCategory === cat.id ? "active" : ""}`}
          >
            <span>{cat.name}</span>
            <span class="sidebar-count">{counts.get(cat.id) ?? 0}</span>
          </a>
        ))
      }
    </aside>

    <div class="shop-content">
      <div class="shop-header">
        <h1>Shop</h1>
        <p>{packs.length} pack{packs.length === 1 ? "" : "s"} available</p>
      </div>
      {
        packs.length === 0 ? (
          <p class="admin-empty">Nothing here yet — check back soon.</p>
        ) : (
          <div class="products-grid">
            {packs.map((pack) => (
              <PackCard
                pack={pack}
                owned={user ? ownsPack(user.id, pack) : false}
              />
            ))}
          </div>
        )
      }
    </div>
  </div>
</Layout>
