---
import Layout from "../layouts/Layout.astro";
import { getSetting } from "../lib/settings";

const isOpen = getSetting("commissions_open") === "1";
const intro =
  getSetting("commissions_intro") ||
  "Want something custom built for your server? Kez takes on commission work for EUP and vehicle modifications, tailored to your community.";
const note =
  getSetting("commissions_note") ||
  (isOpen
    ? "Slots are limited and handled first come, first served. Reach out on Discord to lock yours in."
    : "Commissions are closed while the current queue is finished. Check back soon or watch the Discord for announcements.");
const discordInvite = getSetting("discord_invite_url");
---

<Layout title="Commissions - Kez Modifications" description="Custom FiveM commission work by Kez Modifications." active="commissions">
  <div class="commissions-page">
    <header class="commissions-header">
      <div class="about-label">Commissions</div>
      <h1>
        Commissions are <span class={isOpen ? "status-open" : "status-closed"}>{isOpen ? "OPEN" : "CLOSED"}</span>
      </h1>
      <p>{intro}</p>
    </header>

    {
      !isOpen && (
        <div class="commissions-closed-banner">Commissions are currently closed. {note}</div>
      )
    }

    {
      isOpen && (
        <div class="queue-info">
          <div class="queue-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
          </div>
          <div class="queue-text">
            <strong>Current status</strong>
            <span>{note}</span>
          </div>
        </div>
      )
    }

    {
      isOpen && (
        <div class="commissions-card">
          <div class="commissions-card-title">Start a commission</div>
          <div class="discord-links">
            {discordInvite ? (
              <a href={discordInvite} target="_blank" rel="noopener noreferrer" class="btn-discord">
                <svg viewBox="0 0 127.14 96.36" fill="currentColor" aria-hidden="true">
                  <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z" />
                </svg>
                Open a ticket on Discord
              </a>
            ) : (
              <p style="color: var(--muted);">Ask in the Kez Modifications Discord server to get started.</p>
            )}
          </div>
        </div>
      )
    }
  </div>
</Layout>
