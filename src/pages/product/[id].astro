---
import Layout from "../../layouts/Layout.astro";
import { db } from "../../lib/db";
import type { PackImageRow, PackRow } from "../../lib/db";
import { canView, isDownloadable, ownsPack } from "../../lib/ownership";
import { renderMarkdown, markdownToPlainText } from "../../lib/markdown";

const pack = db
  .prepare("SELECT * FROM packs WHERE id = ?")
  .get(Number(Astro.params.id ?? 0)) as PackRow | undefined;
// hidden packs 404 for the public on purpose, a "this is hidden" page would
// just announce that something's coming
if (!pack || !canView(pack, Astro.locals.user)) return new Response("Not found", { status: 404 });

const gallery = db
  .prepare("SELECT * FROM pack_images WHERE pack_id = ? ORDER BY sort_order, id")
  .all(pack.id) as PackImageRow[];
const images = [
  ...(pack.image_url ? [pack.image_url] : []),
  ...gallery.map((g) => g.url).filter((u) => u !== pack.image_url),
];

const user = Astro.locals.user;
const owned = user ? ownsPack(user.id, pack) : false;
const preordered =
  !owned &&
  !!user &&
  !!db.prepare("SELECT 1 FROM orders WHERE user_id = ? AND pack_id = ? AND status = 'preorder'").get(user.id, pack.id);
const priceLabel = pack.price === 0 ? "Free" : `$${(pack.price / 100).toFixed(2)}`;
const descriptionHtml = renderMarkdown(pack.description);
const descriptionPlain = markdownToPlainText(pack.description);
---

<Layout
  title={`${pack.name} - Kez Modifications`}
  description={descriptionPlain.slice(0, 200)}
  image={images[0] ?? "/images/logo.png"}
>
  <div class="detail-layout">
    <a href="/shop" class="detail-back">← Back to Shop</a>
    <div class="detail-content">
      <div class="detail-gallery">
        <div class="detail-main-img">
          {images[0] && <img id="main-img" src={images[0]} alt={pack.name} />}
        </div>
        {
          images.length > 1 && (
            <div class="detail-thumbs" id="thumbs">
              {images.map((src, i) => (
                <img
                  class={`detail-thumb ${i === 0 ? "active" : ""}`}
                  src={src}
                  alt={`${pack.name} preview ${i + 1}`}
                  data-src={src}
                />
              ))}
            </div>
          )
        }
      </div>

      <div class="detail-info">
        {pack.status === "preorder" && <span class="badge badge-preorder" style="align-self:flex-start;">Pre-Order</span>}
        {pack.status === "coming_soon" && <span class="badge badge-soon" style="align-self:flex-start;">Coming Soon</span>}
        {pack.status === "hidden" && <span class="badge badge-soon" style="align-self:flex-start;">Hidden from shop</span>}
        <div class="detail-name">{pack.name}</div>
        <div class="detail-price">{priceLabel}</div>
        <div class="detail-desc" set:html={descriptionHtml} />

        <div class="error-note" id="buy-error"></div>

        {
          owned ? (
            <>
              <span class="badge badge-owned" style="align-self:flex-start;">Owned</span>
              {isDownloadable(pack) && (
                <a class="btn btn-primary btn-purchase" href={`/api/download/${pack.id}`}>
                  Download
                </a>
              )}
            </>
          ) : preordered ? (
            <>
              <span class="badge badge-preorder" style="align-self:flex-start;">Pre-ordered</span>
              <p class="detail-note">You're in. It lands in your account and your Discord role arrives the day it releases.</p>
            </>
          ) : pack.status === "coming_soon" ? (
            <button class="btn btn-primary btn-purchase" disabled>Coming Soon</button>
          ) : (
            // everything goes through the cart now, free packs included. sign-in
            // and the discount code both happen there, so no branching on user here
            <button class="btn btn-primary btn-purchase" id="cart-btn" data-pack-id={pack.id}>
              Add to Cart
            </button>
          )
        }
        {
          !owned && !preordered && pack.status === "preorder" && (
            <p class="detail-note">Pre-order: you pay now, and it's delivered to your account and Discord the day it releases.</p>
          )
        }
      </div>
    </div>
  </div>
</Layout>

<script>
  import { cart } from "../../lib/cart-client";

  const cartBtn = document.getElementById("cart-btn") as HTMLButtonElement | null;
  if (cartBtn) {
    const id = Number(cartBtn.dataset.packId);
    const paint = () => {
      const inCart = cart.has(id);
      cartBtn.textContent = inCart ? "In cart, view cart" : "Add to Cart";
      cartBtn.classList.toggle("btn-accent-outline", inCart);
      cartBtn.classList.toggle("btn-primary", !inCart);
    };
    paint();
    cartBtn.addEventListener("click", () => {
      if (cart.has(id)) {
        location.href = "/cart";
        return;
      }
      if (!cart.add(id)) {
        document.getElementById("buy-error")!.textContent = "Your cart is full (20 items max)";
        return;
      }
      paint();
    });
  }

  const thumbs = document.getElementById("thumbs");
  const mainImg = document.getElementById("main-img") as HTMLImageElement | null;
  thumbs?.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (!t.classList.contains("detail-thumb") || !mainImg) return;
    mainImg.src = t.dataset.src ?? mainImg.src;
    thumbs.querySelectorAll(".detail-thumb").forEach((el) => el.classList.remove("active"));
    t.classList.add("active");
  });
</script>
