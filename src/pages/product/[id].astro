---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { db } from "../../lib/db";
import type { PackImageRow, PackRow, PackVersionRow } from "../../lib/db";
import { canView, isDownloadable, ownsPack } from "../../lib/ownership";
import { renderMarkdown, markdownToPlainText } from "../../lib/markdown";
import { absoluteUrl, clip, jsonLd } from "../../lib/seo";

const pack = db
  .prepare("SELECT * FROM packs WHERE id = ?")
  .get(Number(Astro.params.id ?? 0)) as PackRow | undefined;
// hidden packs 404 for the public on purpose, a "this is hidden" page would
// just announce that something's coming
if (!pack || !canView(pack, Astro.locals.user)) return new Response("Not found", { status: 404 });

const gallery = db
  .prepare("SELECT * FROM pack_images WHERE pack_id = ? ORDER BY sort_order, id")
  .all(pack.id) as PackImageRow[];
const images = [
  ...(pack.image_url ? [pack.image_url] : []),
  ...gallery.map((g) => g.url).filter((u) => u !== pack.image_url),
];

const user = Astro.locals.user;
const owned = user ? ownsPack(user.id, pack) : false;
const preordered =
  !owned &&
  !!user &&
  !!db.prepare("SELECT 1 FROM orders WHERE user_id = ? AND pack_id = ? AND status = 'preorder'").get(user.id, pack.id);
const priceLabel = pack.price === 0 ? "Free" : `$${(pack.price / 100).toFixed(2)}`;
const descriptionHtml = renderMarkdown(pack.description);
const descriptionPlain = markdownToPlainText(pack.description);

const versions = (
  db.prepare("SELECT * FROM pack_versions WHERE pack_id = ? ORDER BY released_on DESC, id DESC").all(pack.id) as PackVersionRow[]
).map((v) => ({
  ...v,
  // people type "v1.4" and "1.4" interchangeably, normalize so it never reads "vv1.4"
  label: `v${v.version.replace(/^v/i, "")}`,
  // dates are bare YYYY-MM-DD, pin to UTC or it renders a day early in the US
  date: new Date(`${v.released_on}T00:00:00Z`).toLocaleDateString("en-US", {
    timeZone: "UTC",
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
  html: renderMarkdown(v.notes),
}));
const VISIBLE_VERSIONS = 3;

const seoDescription = clip(descriptionPlain || `${pack.name} for FiveM, from Kez Modifications. Pay securely with Stripe and get your Discord role delivered automatically.`);
const canonical = `/product/${pack.id}`;
// coming soon has no price to sell at yet, so no Offer: a Product with a made-up
// availability is worse for rich results than a Product without one
const offer =
  pack.status === "live" || pack.status === "preorder"
    ? {
        "@type": "Offer",
        url: absoluteUrl(canonical),
        priceCurrency: "USD",
        price: (pack.price / 100).toFixed(2),
        availability: pack.status === "preorder" ? "https://schema.org/PreOrder" : "https://schema.org/InStock",
      }
    : undefined;
const productSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: pack.name,
    description: descriptionPlain || undefined,
    image: images.length ? images.map(absoluteUrl) : undefined,
    sku: `kez-${pack.id}`,
    brand: { "@type": "Brand", name: "Kez Modifications" },
    ...(offer ? { offers: { ...offer, seller: { "@type": "Organization", name: "Kez Modifications" } } } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Shop", item: absoluteUrl("/shop") },
      { "@type": "ListItem", position: 2, name: pack.name, item: absoluteUrl(canonical) },
    ],
  },
];
---

<Layout
  title={`${pack.name} - Kez Modifications`}
  description={seoDescription}
  canonical={canonical}
  image={images[0] ?? "/images/og-image.png"}
>
  <script slot="head" type="application/ld+json" set:html={jsonLd(productSchema)} />
  <div class="detail-layout">
    <Breadcrumb items={[{ label: "Shop", href: "/shop" }, { label: pack.name }]} />
    <div class="detail-content">
      <div class="detail-gallery">
        <div class="detail-main-img">
          {images[0] && <img id="main-img" src={images[0]} alt={pack.name} />}
        </div>
        {
          images.length > 1 && (
            <div class="detail-thumbs" id="thumbs">
              {images.map((src, i) => (
                <img
                  class={`detail-thumb ${i === 0 ? "active" : ""}`}
                  src={src}
                  alt={`${pack.name} preview ${i + 1}`}
                  data-src={src}
                />
              ))}
            </div>
          )
        }
      </div>

      <div class="detail-info">
        {pack.status === "preorder" && <span class="badge badge-preorder" style="align-self:flex-start;">Pre-Order</span>}
        {pack.status === "coming_soon" && <span class="badge badge-soon" style="align-self:flex-start;">Coming Soon</span>}
        {pack.status === "hidden" && <span class="badge badge-soon" style="align-self:flex-start;">Hidden from shop</span>}
        <h1 class="detail-name">{pack.name}</h1>
        <div class="detail-price">{priceLabel}</div>
        {versions[0] && (
          <a class="detail-version" href="#update-history">
            Latest {versions[0].label} · updated {versions[0].date}
          </a>
        )}
        <div class="detail-desc" set:html={descriptionHtml} />

        <div class="error-note" id="buy-error"></div>

        {
          owned ? (
            <>
              <span class="badge badge-owned" style="align-self:flex-start;">Owned</span>
              {isDownloadable(pack) && (
                <a class="btn btn-primary btn-purchase" href={`/api/download/${pack.id}`}>
                  Download
                </a>
              )}
            </>
          ) : preordered ? (
            <>
              <span class="badge badge-preorder" style="align-self:flex-start;">Pre-ordered</span>
              <p class="detail-note">You're in. It lands in your account and your Discord role arrives the day it releases.</p>
            </>
          ) : pack.status === "coming_soon" ? (
            <button class="btn btn-primary btn-purchase" disabled>Coming Soon</button>
          ) : (
            // everything goes through the cart now, free packs included. sign-in
            // and the discount code both happen there, so no branching on user here
            <button class="btn btn-primary btn-purchase" id="cart-btn" data-pack-id={pack.id}>
              Add to Cart
            </button>
          )
        }
        {
          !owned && !preordered && pack.status === "preorder" && (
            <p class="detail-note">Pre-order: you pay now, and it's delivered to your account and Discord the day it releases.</p>
          )
        }
      </div>
    </div>

    {
      versions.length > 0 && (
        <section class="update-history" id="update-history" aria-labelledby="uh-title">
          <h2 id="uh-title">Update history</h2>
          <ol class="uh-list">
            {versions.slice(0, VISIBLE_VERSIONS).map((v, i) => (
              <li class="uh-item">
                <div class="uh-head">
                  <strong>{v.label}</strong>
                  {i === 0 && <span class="uh-latest">Latest</span>}
                  <time datetime={v.released_on}>{v.date}</time>
                </div>
                {v.notes && <div class="detail-desc uh-notes" set:html={v.html} />}
              </li>
            ))}
          </ol>
          {versions.length > VISIBLE_VERSIONS && (
            <details class="uh-older">
              <summary>
                Older versions ({versions.length - VISIBLE_VERSIONS})
              </summary>
              <ol class="uh-list">
                {versions.slice(VISIBLE_VERSIONS).map((v) => (
                  <li class="uh-item">
                    <div class="uh-head">
                      <strong>{v.label}</strong>
                      <time datetime={v.released_on}>{v.date}</time>
                    </div>
                    {v.notes && <div class="detail-desc uh-notes" set:html={v.html} />}
                  </li>
                ))}
              </ol>
            </details>
          )}
        </section>
      )
    }
  </div>
</Layout>

<script>
  import { cart } from "../../lib/cart-client";

  const cartBtn = document.getElementById("cart-btn") as HTMLButtonElement | null;
  if (cartBtn) {
    const id = Number(cartBtn.dataset.packId);
    const paint = () => {
      const inCart = cart.has(id);
      cartBtn.textContent = inCart ? "In cart, view cart" : "Add to Cart";
      cartBtn.classList.toggle("btn-accent-outline", inCart);
      cartBtn.classList.toggle("btn-primary", !inCart);
    };
    paint();
    cartBtn.addEventListener("click", () => {
      if (cart.has(id)) {
        location.href = "/cart";
        return;
      }
      if (!cart.add(id)) {
        document.getElementById("buy-error")!.textContent = "Your cart is full (20 items max)";
        return;
      }
      paint();
    });
  }

  const thumbs = document.getElementById("thumbs");
  const mainImg = document.getElementById("main-img") as HTMLImageElement | null;
  thumbs?.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (!t.classList.contains("detail-thumb") || !mainImg) return;
    mainImg.src = t.dataset.src ?? mainImg.src;
    thumbs.querySelectorAll(".detail-thumb").forEach((el) => el.classList.remove("active"));
    t.classList.add("active");
  });
</script>
