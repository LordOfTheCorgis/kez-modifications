---
import Layout from "./Layout.astro";
import { can } from "../lib/perms";
import type { Section } from "../lib/perms";

interface Props {
  section: string;
  title: string;
}

const { section, title } = Astro.props;
const user = Astro.locals.user;

// [url slug, label, permission section]
const items: [string, string, Section][] = [
  ["", "Products", "products"],
  ["categories", "Categories", "products"],
  ["discounts", "Discounts", "discounts"],
  ["orders", "Orders", "orders"],
  ["commissions", "Commissions", "commissions"],
  ["reviews", "Reviews", "reviews"],
  ["staff", "Staff & Users", "users"],
  ["settings", "Settings", "settings"],
];
const visible = items.filter(([, , perm]) => can(user, perm));
const current = items.find(([slug]) => (slug || "products") === section);
const readOnly = !!current && !can(user, current[2], 2);
---

<Layout title={`${title} - Kez Admin`} active="admin">
  <div class="admin-page">
    <div class="admin-layout">
      <aside class="admin-sidebar">
        <div class="admin-sidebar-brand">Admin Panel</div>
        {
          visible.map(([slug, label]) => (
            <a
              href={`/admin${slug ? `/${slug}` : ""}`}
              class={`admin-nav-item ${section === (slug || "products") ? "active" : ""}`}
            >
              {label}
            </a>
          ))
        }
        <div class="admin-sidebar-divider"></div>
        <a href="/" class="admin-nav-item">Back to Site</a>
      </aside>
      <div class={`admin-content ${readOnly ? "admin-readonly" : ""}`}>
        {readOnly && <div class="admin-readonly-note">View only. Ask the owner if you need to make changes here.</div>}
        <slot />
      </div>
    </div>
  </div>
</Layout>

<script>
  // settings + commissions are forms *are* the content, so read-only staff
  // see them greyed out instead of not at all. settings loads its values async,
  // disabling now is fine, disabled inputs still take .value
  document
    .querySelectorAll<HTMLInputElement>(".admin-readonly .admin-readonly-ok :is(input, select, textarea)")
    .forEach((el) => (el.disabled = true));
</script>
