---
import "../styles/base.css";
import "../styles/store.css";
import { getSetting } from "../lib/settings";
import { readCart } from "../lib/cart";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  active?: string;
}

const {
  title = "Kez Modifications",
  description = "Premium FiveM EUP, patches, and EUP models. Server-ready packs crafted with precision.",
  image = "/images/logo.png",
  active = "",
} = Astro.props;

const user = Astro.locals.user;
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "";
const ogImage = image.startsWith("http") ? image : `${siteUrl}${image}`;
const discordInvite = getSetting("discord_invite_url");
const cartCount = readCart(Astro.cookies).length;
const contactEmail = getSetting("contact_email");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <nav>
      <div class="nav-inner">
        <a href="/" class="nav-logo">
          <img src="/images/logo.png" alt="Kez Modifications logo" />
          <div class="nav-brand">KEZ <em>MODIFICATIONS</em></div>
        </a>
        <ul class="nav-links" id="nav-links">
          <li><a href="/" class={`nav-link ${active === "home" ? "active" : ""}`}>Home</a></li>
          <li><a href="/shop" class={`nav-link ${active === "shop" ? "active" : ""}`}>Shop</a></li>
          <li>
            <a href="/commissions" class={`nav-link ${active === "commissions" ? "active" : ""}`}>Commissions</a>
          </li>
          <li>
            <a href="/cart" class={`nav-link nav-cart ${active === "cart" ? "active" : ""}`}>
              Cart
              <span class="nav-cart-count" data-cart-count hidden={cartCount === 0}>{cartCount}</span>
            </a>
          </li>
          {
            user?.isAdmin && (
              <li>
                <a href="/admin" class={`nav-link ${active === "admin" ? "active" : ""}`}>Admin</a>
              </li>
            )
          }
          {/* hamburger-only copies of the avatar menu. on desktop these are hidden
              and the dropdown below does the job; on mobile it's the other way round */}
          {
            user && (
              <>
                <li class="nav-mobile-only">
                  <a href="/account" class={`nav-link ${active === "account" ? "active" : ""}`}>My Account</a>
                </li>
                <li class="nav-mobile-only">
                  <a href="/account#packs" class="nav-link">Downloads</a>
                </li>
                <li class="nav-mobile-only">
                  <form method="post" action="/api/auth/logout">
                    <button type="submit" class="nav-link nav-link-btn">Log out</button>
                  </form>
                </li>
              </>
            )
          }
        </ul>
        {
          user ? (
            <details class="nav-user" id="nav-user">
              <summary aria-label={`Account menu for ${user.name}`} title={user.name}>
                {user.image ? (
                  <img src={user.image} alt="" class="nav-avatar" />
                ) : (
                  <span class="nav-avatar nav-avatar-fallback">{user.name.slice(0, 1).toUpperCase()}</span>
                )}
                <svg class="nav-user-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
              </summary>
              <div class="nav-menu">
                <div class="nav-menu-name">{user.name}</div>
                <a href="/account" class="nav-menu-item">My Account</a>
                <a href="/account#packs" class="nav-menu-item">Downloads</a>
                <form method="post" action="/api/auth/logout">
                  <button type="submit" class="nav-menu-item">Log out</button>
                </form>
              </div>
            </details>
          ) : (
            <a href="/api/auth/login" class="btn btn-primary btn-sm">Sign in</a>
          )
        }
        <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>

    <script>
      const toggle = document.getElementById("nav-toggle");
      toggle?.addEventListener("click", () => {
        const open = document.getElementById("nav-links")!.classList.toggle("open");
        toggle.setAttribute("aria-expanded", String(open));
      });

      // <details> handles open/close + keyboard for free, it just doesn't close
      // when you click elsewhere or hit escape, which every real menu does
      const userMenu = document.getElementById("nav-user") as HTMLDetailsElement | null;
      if (userMenu) {
        document.addEventListener("click", (e) => {
          if (userMenu.open && !userMenu.contains(e.target as Node)) userMenu.open = false;
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && userMenu.open) {
            userMenu.open = false;
            userMenu.querySelector("summary")?.focus();
          }
        });
      }
    </script>

    <main class="page">
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-grid">
          <div class="footer-brand">
            <div class="footer-logo">KEZ MODIFICATIONS</div>
            <p class="footer-tagline">Premium FiveM EUP, patches, and models. Built for servers that care about detail.</p>
            {
              discordInvite && (
                <a href={discordInvite} target="_blank" rel="noopener noreferrer" class="btn-discord btn-discord-sm">
                  <svg viewBox="0 0 127.14 96.36" fill="currentColor" aria-hidden="true">
                    <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z" />
                  </svg>
                  Join the Discord
                </a>
              )
            }
          </div>

          <div class="footer-col" role="navigation" aria-labelledby="footer-shop">
            <h3 id="footer-shop">Shop</h3>
            <a href="/shop" class="footer-link">All packs</a>
            <a href="/commissions" class="footer-link">Commissions</a>
            <a href="/cart" class="footer-link">Cart</a>
            <a href="/account" class="footer-link">Your account</a>
          </div>

          <div class="footer-col" role="navigation" aria-labelledby="footer-support">
            <h3 id="footer-support">Support</h3>
            {discordInvite && (
              <a href={discordInvite} target="_blank" rel="noopener noreferrer" class="footer-link">Discord server</a>
            )}
            {contactEmail && (
              <a href={`mailto:${contactEmail}`} class="footer-link">{contactEmail}</a>
            )}
            <a href="/commissions" class="footer-link">Request a commission</a>
            <a href="/account" class="footer-link">Downloads</a>
          </div>

          <div class="footer-col" role="navigation" aria-labelledby="footer-legal">
            <h3 id="footer-legal">Legal</h3>
            <a href="/terms" class="footer-link">Terms of Service</a>
            <a href="/terms#general" class="footer-link">Refund policy</a>
            <a href="/terms#terms-of-usage" class="footer-link">Usage policy</a>
            <a href="/terms#intellectual-property" class="footer-link">Intellectual property</a>
          </div>
        </div>

        <div class="footer-bottom">
          <p>&copy; 2026 Kez Modifications. Founded April 2026. All rights reserved.</p>
          <p>Not affiliated with Rockstar Games, Take-Two Interactive, or Cfx.re. Payments processed by Stripe.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
